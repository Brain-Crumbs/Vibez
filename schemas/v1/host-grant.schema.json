{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibez.host-grant",
  "title": "Vibez unattended host grant version 1",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "vibez.host-grant"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "grantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
    },
    "projectIdentity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "integrationRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "notBeforeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3,}$"
          },
          "branch": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "taskId",
          "branch",
          "paths"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "Developer",
              "QA",
              "Architect",
              "UAT/Product"
            ]
          },
          "principal": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "network": {
            "enum": [
              "none",
              "restricted"
            ]
          }
        },
        "required": [
          "role",
          "principal",
          "provider",
          "model",
          "tools",
          "network"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$"
          },
          "commandDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "commandDigest"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredReviews": {
      "type": "array",
      "items": {
        "enum": [
          "QA",
          "Architect",
          "UAT/Product"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "start",
          "agent",
          "validator",
          "review",
          "rework",
          "push",
          "publish",
          "ready",
          "merge"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "humanOnly": {
      "type": "array",
      "items": {
        "enum": [
          "start",
          "agent",
          "validator",
          "review",
          "rework",
          "push",
          "publish",
          "ready",
          "merge"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "budgets": {
      "type": "object",
      "properties": {
        "maxConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maxAgentTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCommands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRuntimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxReworks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxConcurrent",
        "maxAgentTurns",
        "maxCommands",
        "maxCostMicros",
        "maxRuntimeMs",
        "maxReworks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaId",
    "schemaVersion",
    "grantId",
    "projectIdentity",
    "configDigest",
    "repository",
    "integrationRef",
    "notBeforeMs",
    "expiresAtMs",
    "tasks",
    "roles",
    "validators",
    "requiredChecks",
    "requiredReviews",
    "actions",
    "humanOnly",
    "budgets"
  ],
  "additionalProperties": false
}
