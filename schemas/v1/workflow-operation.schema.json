{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibez.dev/schemas/v1/workflow-operation.schema.json",
  "title": "Approved workflow plan or durable operation",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId","schemaVersion","planId","tasks","budgets"],
      "properties": {
        "schemaId": {"const":"vibez.workflow-plan"}, "schemaVersion":{"const":"1.0.0"},
        "planId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "tasks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["taskId","issueNumber","definitionSha256"],"properties":{
          "taskId":{"type":"string","pattern":"^[A-Z]+-[0-9]{3,}$"},"issueNumber":{"type":"integer","minimum":1},"definitionSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        }}},
        "budgets":{"type":"object","additionalProperties":false,"required":["maxPolls","maxRetries","maxReworks","maxRuntimeMs","initialDelayMs","maxDelayMs"],"properties":{
          "maxPolls":{"type":"integer","minimum":1,"maximum":10000},"maxRetries":{"type":"integer","minimum":0,"maximum":10},"maxReworks":{"type":"integer","minimum":0,"maximum":10},
          "maxRuntimeMs":{"type":"integer","minimum":1,"maximum":2147483647},"initialDelayMs":{"type":"integer","minimum":1,"maximum":60000},"maxDelayMs":{"type":"integer","minimum":1,"maximum":60000}
        }}
      }
    },
    {
      "type":"object","additionalProperties":false,
      "required":["schemaId","schemaVersion","operationId","planId","planHash","grantDigest","binding","status","startedAtMs","nextAtMs","sequence","controlSequence","polls","retries","reworks","sessions","current","completed","pending","exception"],
      "properties":{
        "schemaId":{"const":"vibez.workflow-operation"},"schemaVersion":{"const":"1.0.0"},
        "operationId":{"type":"string","pattern":"^[a-f0-9-]{36}$"},"planId":{"type":"string","pattern":"^.{0,100}$"},
        "planHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"grantDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"binding":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "status":{"enum":["RUNNING","WAITING","PAUSED","DRAINED","CANCELLED","QUARANTINED","EXCEPTION","DONE"]},
        "startedAtMs":{"type":"integer","minimum":0},"nextAtMs":{"type":"integer","minimum":0},"sequence":{"type":"integer","minimum":1},
        "controlSequence":{"type":"integer","minimum":0},
        "polls":{"type":"integer","minimum":0},"retries":{"type":"integer","minimum":0},"reworks":{"type":"integer","minimum":0},
        "sessions":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-f0-9-]{36}$"}},"current":{"oneOf":[{"type":"string"},{"type":"null"}]},
        "completed":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z]+-[0-9]{3,}$"}},"pending":{"oneOf":[{"type":"string"},{"type":"null"}]},
        "exception":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["code","message","remediation"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"remediation":{"type":"string"}}}]}
      }
    }
  ]
}
