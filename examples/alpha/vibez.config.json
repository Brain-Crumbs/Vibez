{
  "schemaId": "vibez.project-config",
  "schemaVersion": "1.0.0",
  "project": {
    "id": "alpha-demo",
    "repository": "example/alpha"
  },
  "worktree": {
    "id": "primary"
  },
  "paths": {
    "tasks": "work/tasks",
    "requirements": "work/requirements",
    "contracts": "work/contracts",
    "contextPolicy": "work/policy.json",
    "state": ".vibez/state",
    "evidence": ".vibez/evidence",
    "exchange": ".vibez/exchange",
    "intake": ".vibez/inbox/issues",
    "responses": ".vibez/inbox/responses",
    "outbox": ".vibez/outbox",
    "operations": ".vibez/operations"
  },
  "validators": [
    {
      "id": "node-build",
      "executorId": "node-build",
      "required": true
    },
    {
      "id": "node-test",
      "executorId": "node-test",
      "required": true
    }
  ],
  "policy": {
    "integrationTarget": "main",
    "remote": "origin",
    "requiredChecks": [
      "Alpha build",
      "Alpha tests"
    ],
    "reviewRoles": [
      "QA",
      "Architect",
      "UAT/Product"
    ],
    "publication": "host-authorized",
    "merge": "exact-pr-head-host-authorized"
  },
  "providers": {
    "execution": "local-manual",
    "credentials": [
      "github-main"
    ]
  },
  "budgets": {
    "maxAttempts": 3,
    "retryDelayMs": 100,
    "providerTimeoutMs": 3600000,
    "operationTimeoutMs": 14400000,
    "maxReworkCycles": 2
  }
}
